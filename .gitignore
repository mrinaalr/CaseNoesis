# ---------------------------------------------------------------------------
# ML bundles, predictions, exports — ignore models/ except the triage bundle if you
# choose to commit it (optional). Corpus JSON / eval dumps stay local — not in git.
# ---------------------------------------------------------------------------
models/*
!models/triage_bundle.joblib

# JSON data dumps (corpus predictions, extract_evaluation.json, semantic exports, etc.)
# Whitelist JS/TS config, collector profiles, and JSON under data/ except raw press text.
# PDFs stay ignored — never commit collected court or press PDFs.
*.json
!package.json
!package-lock.json
!tsconfig.json
!jsconfig.json
!data/**/*.json
# Raw press text, URL caches, and first-batch manifests stay on disk.
# Public tree keeps data/collected/press_releases/press_lookup.jsonl only.
data/collected/manifests/
data/collected/press_releases/*
!data/collected/press_releases/press_lookup.jsonl
# Fraud-study working logs: full narratives, RECAP download state, and local PDF paths.
# The public reproduce lists are data/collected/public/*.jsonl.
data/collected/recap/fraud/fraud_study.jsonl
data/collected/recap/fraud/fraud_study_status.json
data/collected/recap/fraud/press_docket_queue.jsonl
data/collected/recap/fraud/from_press.jsonl
data/collected/recap/fraud/from_press_tried.jsonl
data/collected/recap/fraud/from_press_status.json
data/collected/recap/bulk/court_manifest.json
# Case Studies authored content (read by the /case-studies tab and the /api/case-studies
# endpoint). Must ship with the deploy or Railway shows "No content yet."
!data/case_studies.json
# Collector domain profiles (authored; must ship).
!collector/profiles/
!collector/profiles/*.json
collector_output/
data/collected/**/tmp/
# Q1 platform harm pipeline — authored + generated artifacts ship with deploy.
!ontology/q1/
!ontology/q1/*.json
!ontology/q2/
!ontology/q2/*.json
!ontology/q3/
!ontology/q3/*.json
# State machine workspace — L* trajectories, lifecycle API, precomputed output.
state_machines/*
!state_machines/__init__.py
!state_machines/iris.py
!state_machines/lifecycle_api.py
!state_machines/sparql_queries.py
!state_machines/trajectory.py
!state_machines/compute_lstar.py
!state_machines/bellman.py
!state_machines/graphs/
!state_machines/graphs/*.jsonld
!state_machines/data/
!state_machines/data/lstar_all_cases.json
# Community notes live in the DB on Railway. data/case_study_notes.json, if present,
# is covered by !data/**/*.json; prefer not to treat it as the production notes store.

# Serialized models / checkpoints (also covered by models/; these catch stray files)
*.joblib
!models/triage_bundle.joblib
*.jbl
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.safetensors
*.h5
*.keras
*.npy
*.npz

# Keys / secrets
*.pem
*.key
credentials/
secrets/

# Local config overrides (not for deploy)
config/

# Temporary files
*.tmp
*.temp

# Ontology merged graph caches (rebuilt locally / on Railway)
ontology/cache/

# ---------------------------------------------------------------------------
# PACER BULK_FOLDER — raw court OCR/screenshots stay local; facts/jsonld ship.
# PDFs at repo root / BULK_FOLDER are already covered by *.pdf above.
# ---------------------------------------------------------------------------
data/PACER/BULK_FOLDER/**/processed/
data/PACER/BULK_FOLDER/outside/
# EXTENSION OCR sidecars — local only, not the collector harvest catalog.
data/PACER/EXTENSION/**/extracted-content.json

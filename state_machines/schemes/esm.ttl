    skos:inScheme <urn:uuid:f5a76868-05ec-5898-aed9-c303f3a30459> ;
    skos:prefLabel "Concealment"@en ;
    uco-core:name "Concealment" .

<urn:uuid:ced87d6a-882e-5b01-9b02-b5c6351ad857> a traj:State,

<urn:uuid:1d8c80eb-4474-5b07-9bf6-86819d2e31c1> a traj:State,
        skos:Concept ;
    skos:broader <urn:uuid:a2ba0f9a-455d-590b-a24e-c011c07a8b31> ;
    skos:definition "Contraband has been supplied to buyers. Harm is delivered, but no victim is the source of what the offender gains."@en ;
    skos:inScheme <urn:uuid:f5a76868-05ec-5898-aed9-c303f3a30459> ;
    skos:prefLabel "ContrabandSupplied"@en ;
    uco-core:name "ContrabandSupplied" .

<urn:uuid:a780b3a4-7f29-52e8-be27-133fa4515443> a traj:State,
        skos:Concept ;
    skos:broader <urn:uuid:9fc82bf5-7ed2-58d0-ab64-69b76e155ea4> ;
    skos:definition "Coercion, held again after exploitation."@en ;
    skos:inScheme <urn:uuid:f5a76868-05ec-5898-aed9-c303f3a30459> ;
    skos:prefLabel "RenewedCoercion"@en ;
    uco-core:name "RenewedCoercion" .

<urn:uuid:cd0761c4-e0d1-54d7-ad82-1193549604e4> a traj:State,

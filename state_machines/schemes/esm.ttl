    skos:definition "Deception, held again after exploitation."@en ;
    skos:inScheme <urn:uuid:f5a76868-05ec-5898-aed9-c303f3a30459> ;
    skos:prefLabel "RenewedDeception"@en ;
    uco-core:name "RenewedDeception" .


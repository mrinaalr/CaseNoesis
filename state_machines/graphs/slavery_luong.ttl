# Forced-labor ESM — United States v. Thuy Tien Luong (W.D.N.C.)
# Split from CASE-UCO-SDK extensions/forced-labor/forced-labor-exemplar.ttl
# for CaseNoesis typology wiring (one trajectory per graph file).
# Source: state_machines/data/press release slavery luong.pdf
# Press: https://www.justice.gov/opa/pr/north-carolina-nail-salon-owner-convicted-forced-labor

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fl: <http://example.org/ontology/forced-labor/> .
@prefix flx: <http://example.org/forced-labor/machine/> .
@prefix lgx: <http://example.org/forced-labor/luong/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix traj: <http://example.org/ontology/trajectories/> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@prefix uco-tool: <https://ontology.unifiedcyberontology.org/uco/tool/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

flx:model-luong a traj:StateMachineModel ;
    traj:hasTransition flx:transition-1,
        flx:transition-2 ;
    traj:hasTransitionEstimate flx:estimate-1,
        flx:estimate-2 ;
    traj:initialState fl:Recruitment ;
    traj:learnedFrom lgx:trajectory-davidson-salon ;
    prov:wasGeneratedBy flx:action-estimate-transitions ;
    uco-core:name "Forced-labor (Luong) state-machine estimate (v0)" .

flx:trigger-wages-taken a uco-core:UcoObject ;
    uco-core:name "Trigger: victim wages appropriated under claimed debt" .

fl:WageAppropriation a traj:State,
        skos:Concept ;
    skos:definition "Terminal modeled endpoint for a finished chain: offender takes the victim's earned income and/or enforces debt bondage over wages claimed as repayment of a fabricated or inflated debt."@en ;
    skos:inScheme fl:PhaseScheme ;
    skos:prefLabel "Wage appropriation"@en ;
    uco-core:name "Wage appropriation" .

lgx:action-coerce a fl:a_coerce,
        uco-action:Action ;
    prov:wasDerivedFrom lgx:evidence-coercion-debt ;
    uco-action:instrument lgx:affordance-employer-workplace ;
    uco-action:performer lgx:person-luong ;
    uco-core:name "Assault, threaten, and bind victim with fabricated debt" .

lgx:action-compel-labor a fl:a_compel_labor,
        uco-action:Action ;
    prov:wasDerivedFrom lgx:evidence-forced-labor ;
    uco-action:instrument lgx:affordance-employer-schedule ;
    uco-action:performer lgx:person-luong ;
    uco-core:name "Compel nail-technician labor 10 hrs/day, 6–7 days/week" .

lgx:confidence-1 a uco-core:ConfidenceFacet ;
    uco-core:confidence "55"^^xsd:nonNegativeInteger .

lgx:confidence-2 a uco-core:ConfidenceFacet ;
    uco-core:confidence "92"^^xsd:nonNegativeInteger .

lgx:confidence-3 a uco-core:ConfidenceFacet ;
    uco-core:confidence "95"^^xsd:nonNegativeInteger .

lgx:evidence-employment-onset a uco-core:UcoObject ;
    prov:wasDerivedFrom lgx:evidence-press-release ;
    uco-core:description "The victim was a nail technician at Luong's Davidson salon. How the victim came to work for Luong is not described in the source; Recruitment occupancy is scoped only to the onset of that labor relationship within the Oct. 2016 – June 2018 span and carries lower confidence. Source: Luong PR." ;
    uco-core:name "Employment relationship onset (recruitment method unspecified)" .

lgx:instant-2016-10-01 a time:Instant ;
    time:inXSDDateTimeStamp "2016-10-01T00:00:00Z"^^xsd:dateTimeStamp .

lgx:instant-2018-06-30 a time:Instant ;
    time:inXSDDateTimeStamp "2018-06-30T23:59:00Z"^^xsd:dateTimeStamp .

lgx:affordance-employer-workplace a uco-core:UcoObject ;
    uco-core:name "Employer control of the workplace" ;
    uco-core:description "Neutral property: owner authority over a workplace affords dominating an already-present employee's presence, exit cost, and daily conditions. Adjacent surfaces also afforded: formal debt/contract instruments (misused as a fabricated $180,000 debt contract with jail threats) and family-reputation disclosure (misused as threats to tell the victim's family damaging information). Physical violence was the misuse of bodily vulnerability and salon tools — not itself an affordance. Source: Luong PR." .

lgx:affordance-employer-schedule a uco-core:UcoObject ;
    uco-core:name "Employer-set labor schedule" ;
    uco-core:description "Neutral property: managerial control of hours and shifts affords compelling long, continuous workweeks. Misuse: Luong required 10-hour days, 6–7 days a week under ongoing coercion (Luong PR)." .

lgx:phase-1 a traj:PhaseAssertion ;
    traj:assertsState fl:Recruitment ;
    traj:atInterval lgx:interval-scheme ;
    traj:sequenceIndex "0"^^xsd:nonNegativeInteger ;
    prov:wasDerivedFrom lgx:evidence-employment-onset ;
    uco-core:description "Onset of the victim's labor relationship at Luong's Davidson salon. Recruitment method is not described in the source; interval is the compelled-labor span (Oct. 2016 – June 2018). Lower confidence accordingly." ;
    uco-core:hasFacet lgx:confidence-1 ;
    uco-core:name "Occupancy assertion 0 — Recruitment" .

lgx:phase-2 a traj:PhaseAssertion ;
    traj:assertsState fl:Control ;
    traj:atInterval lgx:interval-scheme ;
    traj:sequenceIndex "1"^^xsd:nonNegativeInteger ;
    prov:wasDerivedFrom lgx:evidence-coercion-debt ;
    uco-core:description "Victim controlled through physical assault, reputation threats, and a fabricated $180,000 debt contract with jail threats. Source: Luong PR." ;
    uco-core:hasFacet lgx:confidence-2 ;
    uco-core:name "Occupancy assertion 1 — Control" .

lgx:phase-3 a traj:PhaseAssertion ;
    traj:assertsState fl:ForcedLabor ;
    traj:atInterval lgx:interval-scheme ;
    traj:isTerminal true ;
    traj:sequenceIndex "2"^^xsd:nonNegativeInteger ;
    traj:terminalPolarity "disrupted" ;
    prov:wasDerivedFrom lgx:evidence-forced-labor ;
    uco-core:description "Victim compelled to work 10 hours/day, 6–7 days/week until a particularly violent assault led to a report to Davidson Police and Luong's arrest in June 2018 — mid-chain interruption before WageAppropriation endpoint. terminalPolarity is disrupted. Fabricated-debt facts are carried on Control coercion evidence, not as a completed WageAppropriation occupancy. Later conviction (announced 2021-01-08) is outside this machine." ;
    uco-core:hasFacet lgx:confidence-3 ;
    uco-core:name "Occupancy assertion 2 — ForcedLabor (terminal, disrupted)" .

lgx:trajectory-davidson-salon a traj:Trajectory ;
    traj:hasPhaseAssertion lgx:phase-1,
        lgx:phase-2,
        lgx:phase-3 ;
    uco-core:description "United States v. Thuy Tien Luong (W.D.N.C.) — 3-phase occupancy ending mid-chain at ForcedLabor when the victim reported a violent assault and Luong was arrested (June 2018); terminalPolarity disrupted." ;
    uco-core:name "Forced-labor trajectory: Thuy Tien Luong, Davidson nail salon" .

flx:estimate-1 a traj:TransitionEstimate ;
    traj:ofTransition flx:transition-1 ;
    traj:sampleBasis "Illustrative estimate for ESM demonstration; not derived from case-specific frequency data (n=2 trajectories in this exemplar)."^^xsd:string ;
    traj:transitionProbability 0.85 ;
    prov:wasGeneratedBy flx:action-estimate-transitions ;
    uco-core:name "P(Recruitment -> Control)" .

flx:estimate-2 a traj:TransitionEstimate ;
    traj:ofTransition flx:transition-2 ;
    traj:sampleBasis "Illustrative estimate for ESM demonstration; not derived from case-specific frequency data — this is also the transition at which the Luong trajectory terminates disrupted."^^xsd:string ;
    traj:transitionProbability 0.90 ;
    prov:wasGeneratedBy flx:action-estimate-transitions ;
    uco-core:name "P(Control -> ForcedLabor)" .

flx:trigger-labor-compelled a uco-core:UcoObject ;
    uco-core:name "Trigger: victim compelled to perform labor" .

flx:trigger-victim-under-control a uco-core:UcoObject ;
    uco-core:name "Trigger: victim placed under offender control" .

lgx:evidence-coercion-debt a uco-core:UcoObject ;
    prov:wasDerivedFrom lgx:evidence-press-release ;
    uco-core:description "Luong physically assaulted the victim (pulling hair out, stabbing with nail salon tools, pouring acetone on her head); threatened to ruin the victim's reputation with her family; falsely claimed the victim owed her $180,000 for purported poor work performance; executed a debt contract for $180,000 and threatened to send the victim to jail if she did not repay it. Source: Luong PR." ;
    uco-core:name "Physical abuse, reputation threats, and fabricated debt contract" .

lgx:evidence-forced-labor a uco-core:UcoObject ;
    prov:wasDerivedFrom lgx:evidence-press-release ;
    uco-core:description "Luong compelled the victim's labor from October 2016 to June 2018; often treated the victim in a humiliating and demeaning fashion while having her work 10 hours a day for 6 to 7 days a week. A particularly violent assault led to the victim reporting Luong to the Davidson Police Department and to Luong's subsequent arrest in June 2018 — mid-chain interruption. Source: Luong PR." ;
    uco-core:name "Compelled nail-technician labor and disruption" .

lgx:person-luong a uco-core:UcoObject,
        uco-identity:Person ;
    uco-core:description "Age 37, of Charlotte, North Carolina. Owned and operated a nail salon in Davidson, North Carolina. Compelled the labor of one nail technician from October 2016 to June 2018 through physical assault, reputation threats, and a fabricated $180,000 debt contract. Convicted by federal jury in Charlotte after a five-day trial (announced 2021-01-08). Faces maximum 20 years imprisonment and mandatory restitution; sentencing date not scheduled as of the press release. Source: Luong PR." ;
    uco-core:name "Thuy Tien Luong" .

flx:tool-esm-estimator a uco-tool:Tool ;
    uco-core:description "version 0.1.0-dev" ;
    uco-core:name "ESM trajectory estimator (illustrative)" .

flx:transition-1 a traj:Transition ;
    traj:enactsAction lgx:action-coerce ;
    traj:fromState fl:Recruitment ;
    traj:toState fl:Control ;
    traj:trigger flx:trigger-victim-under-control ;
    uco-core:name "Recruitment -> Control" .

flx:transition-2 a traj:Transition ;
    traj:enactsAction lgx:action-compel-labor ;
    traj:fromState fl:Control ;
    traj:toState fl:ForcedLabor ;
    traj:trigger flx:trigger-labor-compelled ;
    uco-core:name "Control -> ForcedLabor" .

fl:ForcedLabor a traj:State,
        skos:Concept ;
    skos:definition "Victim is compelled to work by means of serious harm or abuse, or threats of serious harm or abuse. See 18 U.S.C. § 1589 (https://www.law.cornell.edu/uscode/text/18/1589)."@en ;
    skos:inScheme fl:PhaseScheme ;
    skos:prefLabel "Forced labor"@en ;
    uco-core:name "Forced labor" .

lgx:evidence-press-release a uco-core:UcoObject ;
    uco-core:description "Public DOJ OPA press release dated 2021-01-08 announcing the federal jury conviction of Thuy Tien Luong for forced labor. Document-level citation only. Source URL: https://www.justice.gov/opa/pr/north-carolina-nail-salon-owner-convicted-forced-labor" ;
    uco-core:name "DOJ OPA Luong forced-labor conviction press release" .

lgx:interval-scheme a time:ProperInterval ;
    time:hasBeginning lgx:instant-2016-10-01 ;
    time:hasEnd lgx:instant-2018-06-30 .

flx:action-estimate-transitions a uco-action:Action ;
    prov:wasAssociatedWith flx:tool-esm-estimator ;
    uco-action:instrument flx:tool-esm-estimator ;
    uco-core:name "Estimate forced-labor transition probabilities (illustrative)" .

fl:Control a traj:State,
        skos:Concept ;
    skos:definition "Victim is held under the offender's control — harboring/captivity and/or workplace domination — by force, threats of serious harm, fraud, or coercion, including fabricated debt."@en ;
    skos:inScheme fl:PhaseScheme ;
    skos:prefLabel "Control"@en ;
    uco-core:name "Control" .

fl:Recruitment a traj:State,
        skos:Concept ;
    skos:definition "Victim is brought into the forced-labor scheme (recruitment into an employment or trafficking relationship that leads to compelled labor). See 18 U.S.C. § 1589 and TVPA victim-journey practice."@en ;
    skos:inScheme fl:PhaseScheme ;
    skos:prefLabel "Recruitment"@en ;
    uco-core:name "Recruitment" .

fl:PhaseScheme a skos:ConceptScheme ;
    dcterms:source "United States v. Gladys Ibanez-Olea (N.D. Ill.), USAO-NDIL press release 2026-07-24; United States v. Thuy Tien Luong (W.D.N.C.), DOJ OPA press release 2021-01-08"@en ;
    skos:prefLabel "Forced-labor (debt-bondage) offense phases"@en .

